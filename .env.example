# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Model IDs (Nebius Token Factory). Change here, never in code.
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_DRAFT=nvidia/nemotron-3-super-120b-a12b
MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
# Used when a tier's model returns 404 or is deprecated.
MODEL_FALLBACK=
# Advanced (defaults shown). Token Factory endpoint, retries and timeout per LLM call.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=300
# Nemotron thinking per tier (chat_template_kwargs.enable_thinking).
THINKING_FAST=false
THINKING_DRAFT=false
THINKING_REASONING=true
# Estimated USD per 1M tokens as {"model": [input, output]}, for cost estimates; empty uses the built-in table.
# MODEL_PRICING={"nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B": [0.06, 0.24]}
FRONTEND_ORIGIN=http://localhost:3000

# Usage control for the public demo (days and hours are UTC).
LIVE_RUNS_ENABLED=true
RATE_LIMIT_PER_HOUR=3
RATE_LIMIT_PER_DAY=10
DAILY_CASE_LIMIT=150
# Estimated spend per UTC day: models + Tavily.
DAILY_COST_LIMIT_USD=2
MAX_CONCURRENT_CASES=2
MAX_NARRATIVE_CHARS=4000
MAX_TAVILY_SEARCHES_PER_CASE=10
# Tavily credits (basic search 1, advanced 2, cache hit 0), priced into the case cost.
TAVILY_USD_PER_CREDIT=0.008
TAVILY_DAILY_CREDIT_LIMIT=100
# Main case-law search depth; verification and filing-channel searches are always basic.
TAVILY_RESEARCH_DEPTH=basic
# Search results cache: firestore or file (.cache/tavily); empty = firestore when USAGE_STORE=firestore, else file.
SEARCH_CACHE_STORE=
SEARCH_CACHE_COLLECTION=amparo_search_cache
SEARCH_CACHE_TTL_DAYS=7
# memory (local) or firestore (deployed; counters survive restarts and are shared by instances).
USAGE_STORE=memory
FIRESTORE_PROJECT=
FIRESTORE_COLLECTION=amparo_usage
# Finished .docx/PDF files, downloadable by an unguessable link: memory (local) or gcs (deployed).
DOCUMENT_STORE=memory
DOCUMENTS_BUCKET=
DOCUMENT_TTL_DAYS=7
# Secret key for hashing client IPs; required with USAGE_STORE=firestore.
IP_HASH_KEY=
TRUSTED_PROXY_HOPS=1
# Clarifying-question checks per client IP per hour (per instance), and questions shown at most.
INTAKE_RATE_LIMIT_PER_HOUR=10
MAX_CLARIFYING_QUESTIONS=3

# Judge access: a valid code skips the per-IP and public daily limits; judges have their own daily
# allowance, counted apart. Empty: off. LIVE_RUNS_ENABLED=false stops judges too.
JUDGE_ACCESS_CODE=
JUDGE_DAILY_CASE_LIMIT=100
JUDGE_DAILY_COST_LIMIT_USD=3
JUDGE_TAVILY_DAILY_CREDIT_LIMIT=150
JUDGE_EXTRA_CONCURRENT_CASES=2

# Intake grounding: share of a descriptive field's words that must appear in the narrative
# (denied service; special condition) before escalating or discarding it.
GROUNDING_MIN_OVERLAP=0.75
GROUNDING_MIN_OVERLAP_CONDITION=0.5
